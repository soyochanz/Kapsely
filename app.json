{
  "expo": {
    "name": "Kapsely",
    "slug": "kapsely",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "2.5.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kapsely",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f3f1fe"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kapsely.app",
      "buildNumber": "5",
      "associatedDomains": [
        "applinks:kapsely.com",
        "applinks:www.kapsely.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera to capture memories for your capsules.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone for recording voice notes.",
        "NSUserTrackingUsageDescription": "We use your data to provide personalized ads and improve your experience.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photo library to choose memories for your capsules."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 7,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kapsely.com",
              "pathPrefix": "/capsules"
            },
            {
              "scheme": "https",
              "host": "www.kapsely.com",
              "pathPrefix": "/capsules"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.kapsely.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-tracking-transparency",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "owner": "ochanz",
        "projectId": "83b31c5a-24f0-44d0-9772-00426508c2e8"
      }
    },
    "owner": "ochanz"
  }
}
